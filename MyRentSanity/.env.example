# Copy this file to .env and fill in real values. .env is gitignored.

MYRENT_BASE_URL=https://testee.myrent.it
MYRENT_USERNAME=administrator
MYRENT_PASSWORD=changeme
MYRENT_COMPANY_CODE=test_en

# Operator role — used when the automation dashboard/CLI is run with
# "Run as: Operator" (see README "Automation" section). Only required if you
# actually run as Operator; the Administrator-only vars above are enough
# otherwise.
MYRENT_OPERATOR_USERNAME=Frances
MYRENT_OPERATOR_PASSWORD=changeme
# Only set this if the Operator account logs in with a different company
# code than MYRENT_COMPANY_CODE above — leave unset to reuse it.
# MYRENT_OPERATOR_COMPANY_CODE=test_en
